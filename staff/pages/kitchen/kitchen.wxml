<view class="page kpage {{isTablet ? 'is-tablet' : ''}}">
  <image class="app-bg" src="/assets/images/bg-landscape.jpg" mode="aspectFill"></image>

  <view wx:if="{{noPerm}}" class="login-wrap">
    <view class="login-card">
      <view class="login-seal">掌柜</view>
      <view class="login-title">员工专区</view>
      <view class="login-sub">仅本店员工可查看后厨配菜单</view>
    </view>
  </view>

  <block wx:else>
    <view class="khead">
      <text class="kdate">{{date}} · 后厨配菜单</text>
      <view class="kacts">
        <view class="kbtn" bindtap="refresh">刷新</view>
        <view class="kbtn" bindtap="screenshotTip">出单</view>
      </view>
    </view>

    <!-- 日期切换：日历选择器 + 今天/明天/后天快捷 -->
    <view class="kdatebar">
      <picker mode="date" value="{{date}}" bindchange="onDatePick">
        <view class="kdatepick">📅 {{date}}<text class="kcaret">▾</text></view>
      </picker>
      <view class="kchips">
        <view wx:for="{{chips}}" wx:key="date" class="kchip {{date===item.date?'on':''}}" data-date="{{item.date}}" bindtap="pickChip">{{item.label}}</view>
      </view>
    </view>

    <!-- 餐段筛选 -->
    <view class="kslot">
      <view class="kslot-btn {{slot==='all'?'on':''}}" data-slot="all" bindtap="switchSlot">全天</view>
      <view class="kslot-btn {{slot==='lunch'?'on':''}}" data-slot="lunch" bindtap="switchSlot">午市</view>
      <view class="kslot-btn {{slot==='dinner'?'on':''}}" data-slot="dinner" bindtap="switchSlot">晚市</view>
    </view>

    <view wx:if="{{futureHint}}" class="kfuture">未来日期：仅显示预点菜，现场单需到店后生成</view>

    <view class="kseg">
      <view class="kseg-btn {{view==='kitchen'?'on':''}}" data-view="kitchen" bindtap="switchView">后厨出餐单</view>
      <view class="kseg-btn {{view==='summary'?'on':''}}" data-view="summary" bindtap="switchView">配菜汇总</view>
      <view class="kseg-btn {{view==='procure'?'on':''}}" data-view="procure" bindtap="switchView">食材采购</view>
    </view>

    <!-- 后厨出餐单：按包厢 -->
    <view wx:if="{{view==='kitchen'}}">
      <view wx:if="{{empty}}" class="kempty">{{date}} 暂无已确认预订 / 现场下单</view>
      <view class="kroom" wx:for="{{rooms}}" wx:key="no">
        <view class="kroom-h">{{item.name}}<text class="kroom-no">{{item.no}}号</text></view>

        <block wx:if="{{item.pre.length}}">
          <view class="klabel">预点菜</view>
          <view class="kdish" wx:for="{{item.pre}}" wx:for-item="d" wx:key="name">
            <text class="kdish-name">{{d.name}}</text>
            <text class="kdish-qty">×{{d.qty}}</text>
            <text wx:if="{{d.note}}" class="kdish-note">注：{{d.note}}</text>
          </view>
        </block>

        <block wx:if="{{item.live.length}}">
          <view class="klabel">现场加菜</view>
          <view class="kdish" wx:for="{{item.live}}" wx:for-item="d" wx:key="name">
            <text class="kdish-name">{{d.name}}</text>
            <text class="kdish-qty">×{{d.qty}}</text>
          </view>
        </block>

        <view wx:if="{{item.orderNotes}}" class="korder-note">整单备注：{{item.orderNotes}}</view>
      </view>
    </view>

    <!-- 配菜汇总（数量可改 + 手工补充项） -->
    <view wx:if="{{view==='summary'}}">
      <!-- 顶部条（含手动添加按钮）始终显示，避免空态时新功能入口消失 -->
      <view class="ksum-top">
        <text>{{summary.length ? '合计' : '今日配菜'}}</text>
        <text class="ksum-total">{{totalQty}} 份</text>
        <view class="kadd-btn" bindtap="openManual">＋ 手动添加</view>
      </view>
      <!-- 空态引导（无客人点单时） -->
      <view wx:if="{{summary.length===0}}" class="kempty">{{date}} 暂无自动汇总（尚无预点或现场下单），可点右上角「＋手动添加」补充非菜品项</view>
      <!-- 已有数据列表 -->
      <view class="ksum" wx:for="{{summary}}" wx:key="key" wx:for-item="it">
        <view class="ksum-left">
          <text class="ksum-name {{it.manual ? 'ksum-name-manual' : ''}}">{{it.manual ? '✋ ' : ''}}{{it.name}}</text>
          <text wx:if="{{it.manual && it.note}}" class="ksum-note">备注：{{it.note}}</text>
        </view>
        <view class="ksum-right">
<view class="ksum-qty-edit" data-name="{{it.name}}" data-qty="{{it.qty}}" data-manual="{{it.manual}}" bindtap="openQtyEdit">
              <text class="ksum-qty">{{it.qty}} {{it.unit || '份'}}</text>
              <text class="ksum-qty-unit">· 修改</text>
            </view>
          <text wx:if="{{it.manual}}" class="ksum-del" data-name="{{it.name}}" catchtap="removeExtra">删除</text>
        </view>
      </view>
      <view class="ktip" wx:if="{{summary.length}}">✋ = 手工补充项（不计入食材采购）。点「份数·修改」可改数量——只影响配菜单，不影响顾客订单。</view>
    </view>

    <!-- 食材采购清单（结论 #D：按今日预点+现场单反算每份用料） -->
    <view wx:if="{{view==='procure'}}">
      <view wx:if="{{procure.length===0}}" class="kempty">{{date}} 暂无可用料数据（请先在菜品编辑里填「每份用料」）</view>
      <view class="ksum-top" wx:if="{{procure.length}}">
        <text>采购合计</text>
        <text class="ksum-total">{{procure.length}} 种材料</text>
      </view>
      <view class="ksum" wx:for="{{procure}}" wx:key="mat">
        <text class="ksum-name">{{item.mat}}</text>
        <text class="ksum-qty">×{{item.total}}</text>
      </view>
    </view>

    <view class="ktip">屏幕出单：截图即可投屏 / 打印。后续可接入打印机自动出小票。</view>

    <!-- 手工添加 / 数量修改 弹窗 -->
    <view wx:if="{{manualDlg.show}}" class="kmask" bindtap="closeManual">
      <view class="kdlg" catchtap="noop">
        <view class="kdlg-title">{{manualDlg.mode === 'add' ? '手动添加' : '修改数量'}}</view>
        <block wx:if="{{manualDlg.mode === 'add'}}">
          <input class="kdlg-input" placeholder="名称，如：加一副碗筷 / 加一壶老白茶" value="{{manualDlg.name}}" bindinput="onDlgInput" data-f="name" focus />
          <view class="kdlg-row">
            <input class="kdlg-input kdlg-half" type="digit" placeholder="数量（支持 0.5）" value="{{manualDlg.qty}}" bindinput="onDlgInput" data-f="qty" />
            <input class="kdlg-input kdlg-half" placeholder="单位" value="{{manualDlg.unit}}" bindinput="onDlgInput" data-f="unit" />
          </view>
          <!-- 单位快捷选择（点选填入；右侧输入框可自由填自定义单位） -->
          <view class="kdlg-units">
            <text wx:for="{{['份','把','个','件','斤','克(g)','毫升(ml)','颗']}}" wx:key="*this" class="kdlg-unit-chip {{manualDlg.unit === item ? 'on' : ''}}" data-u="{{item}}" bindtap="pickUnit">{{item}}</text>
          </view>
          <input class="kdlg-input" placeholder="备注（选填），如：客人自备" value="{{manualDlg.note}}" bindinput="onDlgInput" data-f="note" />
        </block>
        <block wx:else>
          <view class="kdlg-edit-name">{{manualDlg.name}}{{manualDlg.isManual ? '（手工项）' : ''}}</view>
          <view class="kdlg-auto" wx:if="{{!manualDlg.isManual}}">系统份数：{{manualDlg.autoQty}} 份 · 改动只影响配菜单</view>
          <input class="kdlg-input" type="number" placeholder="输入新份数" value="{{manualDlg.qty}}" bindinput="onDlgInput" data-f="qty" focus />
        </block>
        <view class="kdlg-btns">
          <view class="kdlg-btn kdlg-cancel" bindtap="closeManual">取消</view>
          <view class="kdlg-btn kdlg-ok" bindtap="saveManual">保存</view>
        </view>
      </view>
    </view>
  </block>
</view>