.page { padding: 32rpx 32rpx 200rpx; }

.ehead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 32rpx;
}
.etitle {
  font-size: 44rpx;
  letter-spacing: 8rpx;
  color: var(--ink);
  font-weight: 500;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.esub { font-size: 24rpx; color: var(--muted); letter-spacing: 2rpx; }
.esave {
  background: var(--cinnabar);
  color: #f4f0e8;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  padding: 18rpx 44rpx;
  border-radius: 1998rpx;
  box-shadow: 0 4rpx 16rpx rgba(160, 69, 56, 0.28);
}
.esave:active { opacity: 0.85; }

.sec { margin-bottom: 52rpx; }
.sec-t {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
  letter-spacing: 2rpx;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.sec-h { font-size: 24rpx; color: var(--muted); font-weight: 400; letter-spacing: 0; }

/* 环境照网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}
.cell {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid var(--border);
  background: var(--paper);
}
.cell-img { width: 100%; height: 100%; }
.cell-bar {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  display: flex;
  justify-content: space-around;
  background: rgba(40, 36, 30, 0.55);
  padding: 10rpx 0;
}
.mini {
  color: #f4f0e8;
  font-size: 26rpx;
  padding: 4rpx 12rpx;
}
.mini.del { color: #f0c9c0; }
.cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--border);
  background: var(--card-soft);
  color: var(--muted);
}
.plus { font-size: 60rpx; line-height: 1; color: var(--gold); }
.plus-t { font-size: 24rpx; margin-top: 8rpx; }

/* 富文本工具栏 */
.toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx;
  background: var(--paper);
  border: 2rpx solid var(--border);
  border-radius: 20rpx 20rpx 0 0;
}
.tb {
  min-width: 68rpx;
  height: 68rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--ink-light);
  background: var(--card);
  border: 2rpx solid var(--border-light);
  border-radius: 16rpx;
}
.tb.img { color: var(--cinnabar); }
.tb:active { background: var(--card-soft); }

.editor-wrap {
  border: 2rpx solid var(--border);
  border-top: none;
  border-radius: 0 0 20rpx 20rpx;
  background: var(--card);
}
.editor {
  width: 100%;
  min-height: 520rpx;
  padding: 28rpx;
  font-size: 30rpx;
  line-height: 1.7;
}

.bottom-pad { height: 40rpx; }
