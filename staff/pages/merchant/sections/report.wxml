    <view>
      <view class="seg">
        <view class="seg-btn {{repMode==='day'?'on':''}}" bindtap="setRep" data-mode="day">按日</view>
        <view class="seg-btn {{repMode==='period'?'on':''}}" bindtap="setRep" data-mode="period">按时段</view>
        <view class="seg-btn {{repMode==='receipt'?'on':''}}" bindtap="setRep" data-mode="receipt">收据</view>
        <picker mode="date" value="{{repDate}}" bindchange="onRepDate"><view class="seg-date">{{repDate}}</view></picker>
      </view>
      <block wx:if="{{repMode==='day'}}">
        <view class="kpi-grid">
          <view class="kpi"><view class="muted">营业额</view><view class="kpi-v">{{repTotalText}}</view></view>
          <view class="kpi"><view class="muted">订单数</view><view class="kpi-v">{{repCount}}</view></view>
        </view>
        <view class="card" wx:for="{{repRows}}" wx:key="id">
          <view class="o-row"><text><text class="price-red">{{item.room_name}}</text>（{{item.room_no}}号）</text><text class="price-red">{{item.totalText}}</text></view>
          <view class="muted">{{item.createdText}}</view>
        </view>
        <view wx:if="{{repRows.length===0}}" class="card muted">该日无已支付订单</view>
      </block>
      <block wx:if="{{repMode==='period'}}">
        <view class="kpi-grid">
          <view class="kpi" wx:for="{{repRows}}" wx:key="k"><view class="muted">{{item.k}}</view><view class="kpi-v">{{item.v}}</view></view>
        </view>
        <view class="kpi" style="grid-column:1/3"><view class="muted">{{repDate}} 合计</view><view class="kpi-v">{{repTotalText}}</view></view>
        <view wx:if="{{repRows.length===0}}" class="card muted">该日无已支付订单</view>
      </block>
      <block wx:if="{{repMode==='receipt'}}">
        <view wx:if="{{mReceipts.length===0}}" class="card muted">暂无电子收据（清台后自动生成）</view>
        <view class="card" wx:for="{{mReceipts}}" wx:key="id" bindtap="openReceipt" data-id="{{item.id}}">
          <view class="o-row">
            <text><text class="price-red">{{item.no}}</text> · {{item.room_name}}（{{item.room_no}}号）</text>
            <text class="pill paid">{{item.paidText}}</text>
          </view>
          <view class="o-items">{{item.date}} {{item.time}} · {{item.pmText}} · {{item.invText}}{{item.phoneLast4 ? ' · 尾号' + item.phoneLast4 : ''}}</view>
          <view class="o-row"><text class="muted">{{item.itemCount}} 项</text><text class="price-red">{{item.totalText}}</text></view>
        </view>
      </block>

      <!-- 老板工具（仅店长） -->
      <view wx:if="{{isManager && repMode==='receipt'}}" class="mtools">
        <view class="mtool" bindtap="pushReminders">补发到店提醒</view>
        <view class="mtool" bindtap="resetDailyFlags">清零售罄标记</view>
        <view class="mtool" bindtap="sweepPending">清理过期申请</view>
      </view>
    </view>
