/* 分包商家页不显示自定义 tabBar：底部只留呼吸位，不照搬全局 200rpx / 478rpx 导航留白 */
.page { padding: 28rpx 28rpx 64rpx; }
.page.is-tablet { padding: 40.5rpx 40.5rpx 96rpx; }

.ipt {
  width: 100%; margin-top: 20rpx; padding: 22rpx 28rpx;
  border: 2rpx solid var(--border); border-radius: 20rpx; font-size: 28rpx;
  background: var(--card-soft); color: var(--ink);
}
.ipt.picker { color: #bcb2a3; }
.ph-light { color: #bcb2a3; }

/* 登录 */
.login-wrap { display: flex; align-items: center; justify-content: center; min-height: 70vh; }
.login-card {
  width: 100%; max-width: 640rpx;
  background: var(--card); border: 2rpx solid var(--border);
  border-radius: 36rpx; padding: 52rpx 44rpx; text-align: center;
  box-shadow: 0 12rpx 44rpx var(--shadow);
}
.login-seal {
  width: 120rpx; height: 120rpx; line-height: 120rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%; background: var(--cinnabar);
  color: var(--card); font-size: 40rpx; font-family: serif; letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(160, 69, 56, 0.2);
}
.login-title { font-size: 36rpx; margin-bottom: 28rpx; color: var(--ink); letter-spacing: 6rpx; }
.login-msg { color: var(--cinnabar); font-size: 26rpx; min-height: 32rpx; margin-top: 12rpx; }
.login-tip { color: var(--muted); font-size: 24rpx; text-align: center; margin-top: 28rpx; }

/* 头部：身份徽标 + 两个快捷入口，压成一行，去掉与系统标题栏重复的大标题 */
.mhead { display: flex; justify-content: space-between; align-items: center; padding: 4rpx 4rpx 24rpx; }
.mhead-l { display: flex; align-items: center; min-width: 0; }
.mhead-r { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.mrole {
  font-size: 22rpx; color: var(--cinnabar); letter-spacing: 2rpx;
  background: #f2e6e2; border: 2rpx solid #ead5ce;
  border-radius: 1998rpx; padding: 4rpx 18rpx;
}
.mback, .mquick {
  font-size: 24rpx; color: var(--ink-light);
  background: var(--card-soft); border: 2rpx solid var(--border);
  border-radius: 1998rpx; padding: 8rpx 22rpx;
}
.mquick { color: var(--cinnabar); border-color: #ead5ce; background: var(--card); }
.logout { font-size: 26rpx; color: var(--muted); }

/* 主 tab：5 格等宽但不折行；店员只有 1 项时不拉成整条 */
.mtabs { display: flex; gap: 10rpx; margin-bottom: 28rpx; }
.mtabs.single .mtab { flex: 0 0 180rpx; }
.mtab {
  flex: 1; min-width: 0; text-align: center; padding: 18rpx 4rpx;
  border-radius: 18rpx; background: var(--paper);
  color: var(--ink-light); font-size: 24rpx;
  border: 2rpx solid var(--border);
  white-space: nowrap;
}
.mtab.on { background: var(--cinnabar); color: #fff; border-color: var(--cinnabar); }

/* 子 tab / 报表分段：与菜品 chips 统一为朱砂选中态，视觉减重 */
.subseg { padding: 6rpx; margin-bottom: 24rpx; background: var(--card-soft); border-color: var(--border-light); }
.subseg-btn { padding: 14rpx 0; font-size: 25rpx; letter-spacing: 1rpx; }
.subseg-btn.on { background: var(--cinnabar); color: #fff; }

/* 订单 */
.o-row { display: flex; justify-content: space-between; align-items: center; }
.o-items { color: var(--muted); font-size: 26rpx; margin: 16rpx 0; line-height: 1.7; }
.o-note { font-size: 24rpx; color: var(--cinnabar); margin: 12rpx 0; line-height: 1.5; }

/* 已清台归档 */
.closed-wrap { margin-top: 36rpx; }
.closed-toggle {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 26rpx; color: var(--ink-light); letter-spacing: 2rpx;
  padding: 20rpx 8rpx; border-top: 2rpx dashed var(--border);
}
.closed-arrow { color: var(--muted); font-size: 24rpx; }
.closed-wrap .card.muted { opacity: 0.72; }

/* 菜品：图与菜名占第一行，4 个操作按钮整行右对齐，不再挤压菜名 */
.m-row { display: flex; gap: 20rpx; align-items: center; flex-wrap: wrap; }
.m-pic { width: 112rpx; height: 112rpx; border-radius: 16rpx; background: var(--paper); flex-shrink: 0; }
.m-pic.ph { display: flex; align-items: center; justify-content: center; font-size: 44rpx; color: var(--cinnabar); background: var(--paper); font-weight: 500; }
.m-info { flex: 1; min-width: 0; }
.m-name { font-size: 30rpx; color: var(--ink); letter-spacing: 2rpx; }
.m-actions {
  display: flex; gap: 12rpx; flex-wrap: wrap; justify-content: flex-end;
  width: 100%; margin-top: 4rpx; padding-top: 16rpx;
  border-top: 2rpx dashed var(--border-light);
}
.m-edit, .m-del, .m-toggle { padding: 10rpx 22rpx; border-radius: 16rpx; font-size: 25rpx; }
.m-edit { background: var(--paper); color: var(--ink); border: 2rpx solid var(--border); }
.m-del { background: #f2e6e2; color: var(--cinnabar); }
.m-toggle { background: var(--paper); color: var(--muted); border: 2rpx solid var(--border); }
.m-toggle.on { background: var(--gold); color: #4a3c1a; border-color: var(--gold); }

/* 报表 */
.seg { display: flex; gap: 10rpx; margin-bottom: 24rpx; align-items: center; flex-wrap: wrap; }
.seg-btn { flex: 1; min-width: 112rpx; text-align: center; border: 2rpx solid var(--border-light); background: var(--card-soft); color: var(--ink-light); padding: 14rpx 8rpx; border-radius: 20rpx; font-size: 25rpx; }
.seg-btn.on { background: var(--cinnabar); color: #fff; border-color: var(--cinnabar); }
.seg-date { border: 2rpx solid var(--border); padding: 14rpx 20rpx; border-radius: 20rpx; font-size: 25rpx; background: var(--card); }
.kpi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-bottom: 28rpx; }
.kpi { background: var(--card); border: 2rpx solid var(--border); border-radius: 28rpx; padding: 28rpx; box-shadow: 0 6rpx 24rpx var(--shadow); }
.kpi-v { font-size: 40rpx; font-weight: 500; color: var(--cinnabar); margin-top: 8rpx; }

/* 收款码：未配置时给一个虚线占位框，不再是一大片无意义空白 */
.qr-card { background: var(--card); border: 2rpx solid var(--border); border-radius: 28rpx; padding: 28rpx; text-align: center; margin-bottom: 24rpx; box-shadow: 0 6rpx 24rpx var(--shadow); }
.qr-card .qn { font-size: 30rpx; font-weight: 500; color: var(--ink); letter-spacing: 2rpx; }
.qr-img { width: 280rpx; height: 280rpx; margin: 20rpx auto; }
.qr-card .qt {
  color: var(--muted); font-size: 24rpx;
  margin: 20rpx 0; padding: 44rpx 0;
  border: 2rpx dashed var(--border-light); border-radius: 20rpx;
  background: var(--card-soft);
}
.qr-card .ipt { margin-top: 12rpx; }

/* 无权限文案 */
.login-sub { font-size: 26rpx; color: var(--muted); margin-bottom: 36rpx; letter-spacing: 2rpx; }
.perm-tip { font-size: 24rpx; color: var(--muted); line-height: 1.7; margin-bottom: 40rpx; }

/* 员工管理分区标题 */
.msec-title {
  font-size: 30rpx; color: var(--ink); letter-spacing: 4rpx;
  margin: 40rpx 0 20rpx; padding-left: 20rpx;
  border-left: 6rpx solid var(--cinnabar);
}

/* 菜品编辑：标签多选 */
.edit-tags { margin-top: 24rpx; }
.edit-label { display: block; font-size: 26rpx; color: var(--ink-light); margin-bottom: 16rpx; letter-spacing: 2rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tag-chip {
  padding: 14rpx 32rpx; border-radius: 40rpx; font-size: 26rpx;
  background: var(--card); color: var(--ink-light);
  border: 2rpx solid var(--border);
}
.tag-chip.on { background: var(--cinnabar); color: #fff; border-color: var(--cinnabar); }

/* 编辑弹窗：售罄 / 限定 开关（第18条） */
.edit-toggles { margin-top: 24rpx; }
.et-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 2rpx solid var(--border-light);
  font-size: 28rpx; color: var(--ink); letter-spacing: 2rpx;
}
.switch {
  position: relative; width: 88rpx; height: 48rpx; border-radius: 1998rpx;
  background: var(--border); transition: background .2s;
}
.switch.on { background: var(--cinnabar); }
.switch-dot {
  position: absolute; top: 4rpx; left: 4rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff;
  transition: left .2s;
}
.switch.on .switch-dot { left: 44rpx; }

/* 后厨配菜单入口（第19条） */
.kitchen-entry {
  display: flex; justify-content: space-between; align-items: center;
  background: var(--cinnabar); color: #fff;
  padding: 26rpx 32rpx; border-radius: 24rpx; margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(160, 69, 56, 0.25);
}
.kitchen-entry:active { opacity: 0.9; }
.ke-title { font-size: 30rpx; letter-spacing: 2rpx; font-weight: 500; }
.ke-arrow { font-size: 28rpx; opacity: 0.9; }

/* 电子收据详情（结论 #E） */
.r-meta { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 24rpx; }
.r-meta text { font-size: 26rpx; color: var(--ink-light); letter-spacing: 1rpx; }
.r-lines { border-top: 2rpx dashed var(--border); border-bottom: 2rpx dashed var(--border); padding: 20rpx 0; margin-bottom: 24rpx; }
.r-line { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 0; font-size: 28rpx; color: var(--ink); }
.r-name { flex: 1; min-width: 0; }
.r-qty { color: var(--muted); font-size: 26rpx; }
.r-sub { color: var(--cinnabar); font-weight: 500; min-width: 112rpx; text-align: right; }
.r-total { margin-top: 8rpx; font-size: 30rpx; }
.r-total .price-red { font-size: 36rpx; }

/* 菜品编辑：每份用料（结论 #D） */
.edit-portions { margin-top: 28rpx; border-top: 2rpx dashed var(--border); padding-top: 24rpx; }

/* 菜品编辑：图片（相册选图上传，替代手动填 URL） */
.edit-pic { margin-top: 24rpx; }
.pic-row { display: flex; align-items: center; gap: 20rpx; }
.pic-prev { width: 160rpx; height: 160rpx; border-radius: 20rpx; background: var(--paper); border: 2rpx solid var(--border); flex-shrink: 0; }
.pic-pick {
  width: 160rpx; height: 160rpx; border-radius: 20rpx;
  border: 2rpx dashed var(--border); background: var(--card);
  color: var(--muted); font-size: 26rpx; letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.pic-del { color: var(--cinnabar); font-size: 26rpx; background: #f2e6e2; padding: 12rpx 24rpx; border-radius: 16rpx; flex-shrink: 0; }

/* 老板工具（补发提醒 / 清零售罄） */
.mtools { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 20rpx; }
.mtool { flex: 1; min-width: 180rpx; text-align: center; padding: 20rpx 8rpx; border-radius: 20rpx; background: var(--paper); color: var(--ink-light); font-size: 25rpx; border: 2rpx solid var(--border); }
.mtool:active { background: var(--ink-light); color: var(--card); }
.por-row { display: flex; gap: 16rpx; align-items: center; margin-bottom: 16rpx; }
.por-mat { flex: 1; min-width: 0; margin-top: 0; }
.por-amt { width: 184rpx; margin-top: 0; }
.por-del { padding: 16rpx 20rpx; color: var(--cinnabar); font-size: 26rpx; background: #f2e6e2; border-radius: 16rpx; flex-shrink: 0; }
.por-add { margin-top: 4rpx; background: var(--paper); color: var(--ink-light); border: 2rpx solid var(--border); }

/* 菜品管理 · 筛选条 + 分组（2026-09-26 借鉴菜单页 UX） */
.chip-rail {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 4rpx 0;
}
.chip-rail.static { white-space: normal; }
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 36rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  background: var(--card);
  color: var(--ink-light);
  border: 2rpx solid var(--border);
}
.chip.on {
  background: var(--cinnabar);
  color: #fff;
  border-color: var(--cinnabar);
}
.chip.search {
  background: var(--paper);
  color: var(--muted);
  border-style: dashed;
}
.dish-section { margin-top: 12rpx; }
.sec-title {
  display: flex; align-items: center;
  margin: 24rpx 0 12rpx;
}
.sec-title text {
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 4rpx;
  font-weight: 500;
  margin-right: 16rpx;
}
.sec-line {
  flex: 1; height: 0; border-top: 2rpx dashed var(--border);
}
.search-mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
  display: flex; flex-direction: column;
}
.search-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 18rpx 24rpx;
  background: var(--card);
  border-bottom: 2rpx solid var(--border);
}
.sb-ic { color: var(--muted); font-size: 32rpx; }
.sb-input {
  flex: 1; min-width: 0;
  background: var(--paper);
  border-radius: 28rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.sb-close { color: var(--ink-light); font-size: 26rpx; padding: 0 8rpx; }
.search-res { flex: 1; padding: 24rpx; background: var(--paper); }
.s-empty {
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  padding: 60rpx 0;
  letter-spacing: 2rpx;
}

/* ===== 平板放大：补齐全局 .is-tablet 未覆盖的商家后台专属类 =====
   全局 app.wxss 只放大了 btn/pill/muted/ipt 等通用类，商家页的导航与
   操作按钮仍是手机字号，会出现「头小身大」。这里按同一倍率补齐。 */
.is-tablet .mhead { padding: 8rpx 4rpx 40rpx; }
.is-tablet .mhead-r { gap: 20rpx; }
.is-tablet .mrole { font-size: 44rpx; padding: 6rpx 30rpx; }
.is-tablet .mback, .is-tablet .mquick { font-size: 48rpx; padding: 14rpx 38rpx; }
.is-tablet .mtabs { gap: 20rpx; margin-bottom: 44rpx; }
.is-tablet .mtabs.single .mtab { flex: 0 0 320rpx; }
.is-tablet .mtab { font-size: 52rpx; padding: 28rpx 6rpx; border-radius: 28rpx; }
.is-tablet .subseg-btn { font-size: 60rpx; padding: 24rpx 0; }
.is-tablet .seg-btn { font-size: 54rpx; padding: 26rpx 10rpx; }
.is-tablet .seg-date { font-size: 52rpx; padding: 26rpx 34rpx; }
.is-tablet .kpi { padding: 40rpx; }
.is-tablet .kpi-v { font-size: 80rpx; }
.is-tablet .chip { font-size: 52rpx; padding: 20rpx 44rpx; }
.is-tablet .msec-title { font-size: 60rpx; margin: 56rpx 0 28rpx; }
.is-tablet .m-pic { width: 180rpx; height: 180rpx; border-radius: 24rpx; }
.is-tablet .m-name { font-size: 58rpx; }
.is-tablet .price { font-size: 56rpx; }
.is-tablet .m-edit, .is-tablet .m-del, .is-tablet .m-toggle { font-size: 50rpx; padding: 18rpx 34rpx; }
.is-tablet .mtool { font-size: 50rpx; padding: 32rpx 12rpx; }
.is-tablet .qr-card .qn { font-size: 58rpx; }
.is-tablet .qr-img { width: 460rpx; height: 460rpx; }
.is-tablet .qr-card .qt { font-size: 50rpx; padding: 70rpx 0; }
.is-tablet .m-pic.ph { font-size: 72rpx; }

/* ===== 时价菜（2026-11-16）：菜品「时价」标、订单待定价红标、定价弹窗 ===== */
.market-price { color: var(--cinnabar); letter-spacing: 2rpx; font-weight: 500; }
.price-pending-bar {
  margin-top: 14rpx; padding: 10rpx 20rpx; border-radius: 12rpx;
  background: #f2e6e2; color: var(--cinnabar);
  font-size: 24rpx; letter-spacing: 1rpx;
}
.o-items .pending-item { color: var(--cinnabar); }
.o-actions { display: flex; gap: 12rpx; flex-wrap: wrap; justify-content: flex-end; margin: 4rpx 0 14rpx; }
.o-btn {
  padding: 10rpx 22rpx; border-radius: 16rpx; font-size: 25rpx;
  background: var(--paper); color: var(--ink-light); border: 2rpx solid var(--border);
}
.o-btn.main { background: var(--cinnabar); color: #fff; border-color: var(--cinnabar); }
.price-pick-list { max-height: 420rpx; margin: 16rpx 0; }
.price-pick {
  display: flex; justify-content: space-between; align-items: center; gap: 16rpx;
  padding: 20rpx; margin-bottom: 12rpx; border-radius: 16rpx;
  border: 2rpx solid var(--border-light); background: var(--card-soft);
  font-size: 26rpx; color: var(--ink);
}
.price-pick.on { border-color: var(--cinnabar); background: #f2e6e2; }
.price-pick.pending text:last-child { color: var(--cinnabar); }
.price-tip { font-size: 24rpx; color: var(--muted); line-height: 1.6; margin: 12rpx 0; }

.is-tablet .price-pending-bar { font-size: 44rpx; padding: 16rpx 30rpx; }
.is-tablet .o-btn { font-size: 46rpx; padding: 18rpx 34rpx; }
.is-tablet .price-pick { font-size: 48rpx; padding: 28rpx; }
.is-tablet .price-pick-list { max-height: 640rpx; }
.is-tablet .price-tip { font-size: 44rpx; }

/* ===== 今日时价快改（2026-11-17）：一屏列出时价菜，逐行填价，一键保存 ===== */
.mp-head { padding: 28rpx 30rpx; margin-bottom: 20rpx; }
.mp-title { font-size: 32rpx; color: var(--ink); letter-spacing: 3rpx; font-weight: 600; }
.mp-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--muted); line-height: 1.7; }
.mp-row { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 26rpx; }
.mp-info { flex: 1; min-width: 0; }
.mp-name { font-size: 28rpx; color: var(--ink); }
.mp-cat { margin-top: 6rpx; font-size: 22rpx; color: var(--muted); }
.mp-input {
  width: 200rpx; flex: none; padding: 14rpx 18rpx;
  background: var(--paper); border: 2rpx solid var(--border);
  border-radius: 14rpx; font-size: 28rpx; color: var(--ink); text-align: right;
}
.is-tablet .mp-head { padding: 40rpx 44rpx; }
.is-tablet .mp-title { font-size: 52rpx; }
.is-tablet .mp-sub { font-size: 40rpx; }
.is-tablet .mp-row { padding: 32rpx 38rpx; }
.is-tablet .mp-name { font-size: 46rpx; }
.is-tablet .mp-cat { font-size: 36rpx; }
.is-tablet .mp-input { width: 300rpx; font-size: 46rpx; padding: 20rpx 26rpx; }
