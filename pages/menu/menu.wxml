<view class="page">
  <image class="app-bg" src="/assets/images/bg-landscape.jpg" mode="aspectFill"></image>

  <!-- 顶栏 -->
  <view class="topbar">
    <view class="tb-left">
      <view class="tb-name">半山·一席</view>
      <view class="tb-sub">
        <block wx:if="{{appendMode && appendTarget==='reservation'}}">为 {{appendTargetLabel}} 改预点</block>
        <block wx:elif="{{appendMode}}">为 {{appendTargetLabel}} 追加菜品</block>
        <block wx:elif="{{preorder}}">预订预点菜</block>
        <block wx:else>{{roomName + ' · '}}<text class="link" bindtap="setPeople">{{people}}人</text></block>
      </view>
    </view>
    <view class="tb-search" bindtap="openSearch">
      <text class="tb-search-ic">⌕</text>
      <text class="tb-search-tx">搜索菜品</text>
    </view>
  </view>

  <!-- 预点锁定提示（仅改预点且距用餐不足2天时显示） -->
  <view wx:if="{{preorder && locked}}" class="lock-bar">
    <view class="lock-txt">距用餐已不足 2 天，预点已锁定，修改请到店后联系店员代加</view>
    <view wx:if="{{storePhone}}" class="lock-call" bindtap="callStore">拨打店员 {{storePhone}}</view>
  </view>

  <!-- 左栏 + 右分区 -->
  <view class="body">
    <scroll-view class="rail" scroll-y>
      <view wx:for="{{cats}}" wx:key="*this"
            class="rail-item {{activeCat===item?'on':''}}"
            bindtap="setCat" data-cat="{{item}}">{{item}}</view>
    </scroll-view>

    <scroll-view class="panel" scroll-y scroll-into-view="{{scrollIntoId}}" scroll-with-animation bindscroll="onPanelScroll">
      <view class="sec" wx:for="{{sections}}" wx:key="cat" wx:for-index="si" id="sec-{{si}}">
        <view class="sec-title"><text>{{item.cat}}</text><view class="sec-line"></view></view>
        <view class="card {{d.soldOut?'sold-out':''}}" wx:for="{{item.items}}" wx:for-item="d" wx:key="id">
          <image wx:if="{{d.image}}" class="pic" src="{{d.image}}" mode="aspectFill" lazy-load />
          <view wx:else class="pic seal">{{d.ph}}</view>
          <view wx:if="{{d.limited}}" class="corner limited">今日限定</view>
          <view wx:if="{{d.soldOut}}" class="corner soldout">售罄</view>
          <view class="info">
            <view class="ttl">{{d.name}}</view>
            <view class="badges" wx:if="{{d.badges.length}}">
              <text wx:for="{{d.badges}}" wx:for-item="b" wx:key="label" class="badge {{b.cls}}">{{b.label}}</text>
            </view>
            <view class="desc">{{d.description || (d.specs && d.specs.length ? '可选规格' : '')}}</view>
            <view class="bottom">
              <text class="price-red">¥{{d.price}}</text>
              <view class="step">
                <view wx:if="{{qtyMap[d.id]}}" class="minus" bindtap="decDish" data-id="{{d.id}}">−</view>
                <text wx:if="{{qtyMap[d.id]}}" class="n">{{qtyMap[d.id]}}</text>
                <view class="plus" bindtap="addDish" data-id="{{d.id}}">+</view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="sec-foot"></view>
    </scroll-view>
  </view>

  <!-- 底部购物车 -->
  <view class="cartbar" wx:if="{{cartCount>0}}">
    <view class="cart-left" bindtap="openCart">
      <view class="bag">篮<view wx:if="{{cartCount>0}}" class="bag-badge">{{cartCount}}</view></view>
      <view class="cart-sum">
        <text class="cart-total">{{cartTotalText}}</text>
        <text class="cart-count">共 {{cartCount}} 件 · 点此查看</text>
      </view>
    </view>
    <view wx:if="{{!locked}}" class="btn-checkout" bindtap="openCart">{{appendMode ? '确认追加' : '去结算'}}</view>
  </view>
</view>

<!-- 规格弹窗 -->
<view class="mask" wx:if="{{showSpec}}" bindtap="closeSpec">
  <view class="modal" catchtap="noop">
    <view class="modal-title">{{spec.dish.name}}</view>
    <view wx:for="{{spec.groups}}" wx:key="group" class="spec-group">
      <view class="g-name">{{item.group}}</view>
      <view class="spec-chips">
        <view wx:for="{{item.options}}" wx:for-item="opt" wx:key="label"
              class="spec-chip {{spec.picked[item.group]===opt.label?'on':''}}"
              bindtap="pickSpec" data-group="{{item.group}}" data-label="{{opt.label}}">
          {{opt.label}}<text wx:if="{{opt.delta}}"> (+{{opt.delta}})</text>
        </view>
      </view>
    </view>
    <view class="spec-foot">
      <view class="qty-stepper">
        <view class="qs" bindtap="specQty" data-d="-1">−</view>
        <text>{{spec.qty}}</text>
        <view class="qs" bindtap="specQty" data-d="1">+</view>
      </view>
      <text class="spec-preview">{{spec.totalText}}</text>
    </view>
    <view class="btn" style="width:100%;margin-top:16px;" bindtap="confirmSpec">加入购物车</view>
  </view>
</view>

<!-- 结账单 -->
<view class="mask" wx:if="{{showBill}}" bindtap="closeBill">
  <view class="modal" catchtap="noop">
    <view class="modal-title">下单成功</view>
    <view class="b-row"><text>包厢</text><text>{{bill.roomName}}（{{bill.roomNo}}号）</text></view>
    <view class="b-row"><text>人数</text><text>{{bill.people}} 人</text></view>
    <view class="b-row" wx:if="{{bill.note}}"><text>备注</text><text class="b-note">{{bill.note}}</text></view>
    <view class="b-items">
      <view class="b-row" wx:for="{{bill.items}}" wx:key="idx">
        <text>{{item.name}}{{item.selText}} ×{{item.qty}}</text>
        <text>{{item.subtotalText}}</text>
      </view>
    </view>
    <view class="b-row total-line">
      <text>合计</text><text class="price-red">{{bill.totalText}}</text>
    </view>
    <view class="btn" style="width:100%;margin-top:12px;" bindtap="closeBill">完成</view>
    <view class="btn btn-ghost" style="width:100%;margin-top:8px;" bindtap="goOrders">查看我的订单</view>
  </view>
</view>

<!-- 购物篮弹窗：菜品行 + 规格 + 右侧价格，可改数量 / 删除 -->
<view class="mask" wx:if="{{showCart}}" bindtap="closeCart">
  <view class="modal" catchtap="noop">
    <view class="modal-title">购物篮<text class="modal-close" catchtap="closeCart">✕</text></view>
    <scroll-view class="cart-list" scroll-y>
      <view class="cart-line" wx:for="{{cartGroups}}" wx:key="key">
        <view class="cl-info">
          <view class="cl-name">{{item.name}}<text wx:if="{{item.selText}}" class="cl-sel">{{item.selText}}</text></view>
          <text class="cl-unit">单价 {{item.unitPriceText}}</text>
        </view>
        <view class="cl-right">
          <view class="step">
            <view class="minus" catchtap="decCart" data-key="{{item.key}}">−</view>
            <text class="n">{{item.qty}}</text>
            <view class="plus" catchtap="incCart" data-key="{{item.key}}">+</view>
          </view>
          <text class="cl-price">{{item.lineTotal}}</text>
          <text class="cl-del" catchtap="delCart" data-key="{{item.key}}">删除</text>
        </view>
      </view>
    </scroll-view>
    <view class="cart-foot">
      <view class="cart-foot-sum">合计 <text class="price-red">{{cartTotalText}}</text></view>
      <view wx:if="{{!locked}}" class="btn btn-checkout" catchtap="goConfirm">去结算</view>
    </view>
  </view>
</view>

<!-- 确认订单弹窗：同内容只读 + 合计 + 备注(输入) + 确认结算 -->
<view class="mask" wx:if="{{showConfirm}}" bindtap="closeConfirm">
  <view class="modal" catchtap="noop">
    <view class="modal-title">{{appendMode ? '确认追加菜品' : (preorder ? '确认预点菜' : '确认订单')}}<text class="modal-close" catchtap="closeConfirm">✕</text></view>
    <scroll-view class="cart-list" scroll-y>
      <view class="cart-line" wx:for="{{cartGroups}}" wx:key="key">
        <view class="cl-info">
          <view class="cl-name">{{item.name}}<text wx:if="{{item.selText}}" class="cl-sel">{{item.selText}}</text></view>
          <text class="cl-unit">{{item.unitPriceText}} × {{item.qty}}</text>
        </view>
        <text class="cl-price">{{item.lineTotal}}</text>
      </view>
    </scroll-view>
    <view class="confirm-sum">
      <text class="cs-label">合计</text>
      <text class="price-red">{{cartTotalText}}</text>
    </view>
    <view class="note-block">
      <text class="note-label">备注</text>
      <textarea class="note-input" placeholder="口味、忌口、用餐时间等" value="{{note}}" bindinput="onNoteInput" maxlength="200"></textarea>
    </view>
    <view wx:if="{{!locked}}" class="btn btn-checkout" catchtap="submitOrder">{{appendMode ? '确认追加' : (preorder ? '保存预点菜' : '确认结算')}}</view>
    <view wx:else class="btn btn-checkout disabled">已锁定</view>
  </view>
</view>

<!-- 搜索浮层（搜索页） -->
<view class="mask search-mask" wx:if="{{showSearch}}" bindtap="closeSearch">
  <view class="search-page" catchtap="noop">
    <view class="search-bar">
      <text class="sb-ic">⌕</text>
      <input class="sb-input" placeholder="输入菜名，模糊搜索" value="{{searchKeyword}}"
             bindinput="onSearchInput" focus="{{showSearch}}" confirm-type="search" />
      <text class="sb-close" bindtap="closeSearch">取消</text>
    </view>
    <scroll-view class="search-res" scroll-y>
      <view wx:if="{{!searchKeyword}}" class="s-empty">输入菜名试试，如「东坡」「醉」</view>
      <view wx:elif="{{searchResults.length===0}}" class="s-empty">没有找到「{{searchKeyword}}」</view>
      <view class="card {{item.soldOut?'sold-out':''}}" wx:for="{{searchResults}}" wx:key="id">
        <image wx:if="{{item.image}}" class="pic" src="{{item.image}}" mode="aspectFill" lazy-load />
        <view wx:else class="pic seal">{{item.ph}}</view>
        <view wx:if="{{item.limited}}" class="corner limited">今日限定</view>
        <view wx:if="{{item.soldOut}}" class="corner soldout">售罄</view>
        <view class="info">
          <view class="ttl">{{item.name}}</view>
          <view class="badges" wx:if="{{item.badges.length}}">
            <text wx:for="{{item.badges}}" wx:for-item="b" wx:key="label" class="badge {{b.cls}}">{{b.label}}</text>
          </view>
          <view class="desc">{{item.description || (item.specs && item.specs.length ? '可选规格' : '')}}</view>
          <view class="bottom">
            <text class="price-red">¥{{item.price}}</text>
            <view class="step">
              <view wx:if="{{qtyMap[item.id]}}" class="minus" bindtap="decDish" data-id="{{item.id}}">−</view>
              <text wx:if="{{qtyMap[item.id]}}" class="n">{{qtyMap[item.id]}}</text>
              <view class="plus" bindtap="addDish" data-id="{{item.id}}">+</view>
            </view>
          </view>
        </view>
      </view>
      <view class="sec-foot"></view>
    </scroll-view>
  </view>
</view>
