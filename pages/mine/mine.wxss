.page {
  position: relative;
  z-index: 1;
  min-height: 100%;
  padding-bottom: 40px;
}
.app-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  z-index: -1;
}

/* 加载 */
.loading-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(226, 222, 214, .6);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  z-index: 50;
}
.spinner {
  width: 36px; height: 36px;
  border: 3px solid #d8d2c6; border-top-color: #9e3b2e;
  border-radius: 50%; animation: spin .8s linear infinite;
}
.loading-tip { margin-top: 10px; color: #8a8175; font-size: 13px; }
@keyframes spin { to { transform: rotate(360deg); } }

/* 个人信息 */
.head { display: flex; flex-direction: column; align-items: center; padding: 26px 0 10px; }
.h-logo { width: 84rpx; height: 84rpx; }
.h-name { font-size: 20px; color: #3a352e; margin-top: 10px; letter-spacing: 2px; }
.h-edit { font-size: 12px; color: #9e3b2e; margin-left: 10px; }
.h-phone { font-size: 13px; color: #8a8175; margin-top: 4px; }

/* 区块标题 */
.sec {
  font-size: 15px; color: #3a352e; font-weight: 600;
  margin: 18px 16px 8px; letter-spacing: 1px;
  border-left: 3px solid #9e3b2e; padding-left: 10px;
}

/* 卡片 */
.mcard {
  background: #f6f2ea; border-radius: 12px; padding: 14px;
  margin: 0 16px 12px; box-shadow: 0 2px 8px rgba(80, 70, 55, .06);
}
.mcard-top { display: flex; justify-content: space-between; align-items: center; font-size: 15px; color: #3a352e; }
.mcard-info { font-size: 13px; color: #6b6359; margin-top: 6px; }
.mcard-note { font-size: 12px; color: #9e3b2e; margin-top: 6px; }
.mcard-ops { display: flex; gap: 10px; margin-top: 10px; }
.op { font-size: 13px; color: #9e3b2e; border: 1px solid #d8b78a; border-radius: 20px; padding: 4px 14px; }
.op-cancel { color: #8a8175; border-color: #d8d2c6; }
.op-lock { color: #8a8175; border-color: #d8d2c6; background: rgba(120,112,102,.08); }

.po-list { font-size: 13px; color: #6b6359; line-height: 1.8; margin-top: 6px; }
.mcard-tip { font-size: 11px; color: #a99e8c; margin-top: 8px; }

/* 状态徽标 */
.badge { font-size: 12px; padding: 2px 10px; border-radius: 20px; }
.badge-pending { background: rgba(196, 163, 90, .18); color: #b08a3e; }
.badge-confirmed { background: rgba(74, 142, 92, .18); color: #3f8a55; }
.badge-rejected, .badge-cancelled { background: rgba(120, 112, 102, .18); color: #7a716a; }
.badge-locked { background: rgba(120, 112, 102, .14); color: #7a716a; }

/* 进度条 */
.prog { display: flex; justify-content: space-between; margin: 12px 0 2px; }
.prog-step { flex: 1; display: flex; flex-direction: column; align-items: center; font-size: 11px; color: #a99e8c; }
.prog-step .dot {
  width: 14px; height: 14px; border-radius: 50%; background: #d8d2c6;
  margin-bottom: 4px; border: 2px solid #fff; box-shadow: 0 0 0 1px #cdc6b8;
}
.prog-step.on { color: #9e3b2e; }
.prog-step.on .dot { background: #9e3b2e; box-shadow: 0 0 0 1px #9e3b2e; }

/* 主按钮 */
.btn-apply {
  margin: 6px 16px 4px; background: #9e3b2e; color: #fff;
  text-align: center; padding: 12px; border-radius: 24px;
  font-size: 15px; letter-spacing: 2px;
}
.btn-apply-top {
  margin-top: 10px;
  margin-bottom: 10px;
}

.empty { text-align: center; color: #a99e8c; font-size: 13px; padding: 12px 0 4px; }
.entry { text-align: center; padding: 18px; color: #8a8175; font-size: 13px; margin-top: 8px; }

/* 弹窗 */
.mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(30, 28, 24, .72);
  display: flex; align-items: center; justify-content: center; z-index: 60;
}
.modal {
  width: 80%; background: #f6f2ea; border-radius: 14px; padding: 20px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, .3);
}
.modal-title { text-align: center; font-size: 16px; color: #3a352e; margin-bottom: 14px; letter-spacing: 1px; }
.ipt {
  width: 100%; box-sizing: border-box;
  background: #fff; border: 1px solid #d8d2c6; border-radius: 8px;
  padding: 10px 12px; font-size: 28rpx; color: #3a352e;
}
.btn {
  background: #9e3b2e; color: #fff; text-align: center;
  padding: 11px; border-radius: 24px; font-size: 15px; letter-spacing: 1px;
}
.btn-del {
  background: transparent; color: #8a8175; text-align: center;
  padding: 11px; border-radius: 24px; font-size: 14px;
  border: 1px solid #d8d2c6;
}
