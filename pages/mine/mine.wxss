.page {
  position: relative;
  z-index: 1;
  min-height: 100%;
  padding-bottom: 80rpx;
}
.tablet-debug {
  position: fixed; top: 12rpx; right: 12rpx;
  background: rgba(160, 69, 56, .85); color: #fff;
  font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 8rpx;
  z-index: 200; pointer-events: none;
}
.app-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  z-index: -1;
}

/* 加载 */
.loading-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(226, 222, 214, .6);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  z-index: 50;
}
.spinner {
  width: 72rpx; height: 72rpx;
  border: 6rpx solid #d8d2c6; border-top-color: #9e3b2e;
  border-radius: 50%; animation: spin .8s linear infinite;
}
.loading-tip { margin-top: 20rpx; color: #8a8175; font-size: 26rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* 个人信息 */
.head { display: flex; flex-direction: column; align-items: center; padding: 52rpx 0 20rpx; }
.h-logo { width: 84rpx; height: 84rpx; }
.h-name { font-size: 40rpx; color: #3a352e; margin-top: 20rpx; letter-spacing: 4rpx; }
.h-edit { font-size: 24rpx; color: #9e3b2e; margin-left: 20rpx; }
.h-phone { font-size: 26rpx; color: #8a8175; margin-top: 8rpx; }

/* 区块标题 */
.sec {
  font-size: 30rpx; color: #3a352e; font-weight: 600;
  margin: 36rpx 32rpx 16rpx; letter-spacing: 2rpx;
  border-left: 6rpx solid #9e3b2e; padding-left: 20rpx;
}

/* 卡片 */
.mcard {
  background: #f6f2ea; border-radius: 24rpx; padding: 28rpx;
  margin: 0 32rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(80, 70, 55, .06);
}
.mcard-top { display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; color: #3a352e; }
.mcard-info { font-size: 26rpx; color: #6b6359; margin-top: 12rpx; }
.mcard-note { font-size: 24rpx; color: #9e3b2e; margin-top: 12rpx; }
.mcard-ops { display: flex; gap: 20rpx; margin-top: 20rpx; }
.op { font-size: 26rpx; color: #9e3b2e; border: 2rpx solid #d8b78a; border-radius: 40rpx; padding: 8rpx 28rpx; }
.op-cancel { color: #8a8175; border-color: #d8d2c6; }
.op-lock { color: #8a8175; border-color: #d8d2c6; background: rgba(120,112,102,.08); }

.po-list { font-size: 26rpx; color: #6b6359; line-height: 1.8; margin-top: 12rpx; }
.mcard-tip { font-size: 22rpx; color: #a99e8c; margin-top: 16rpx; }

/* 状态徽标 */
.badge { font-size: 24rpx; padding: 4rpx 20rpx; border-radius: 40rpx; }
.badge-pending { background: rgba(196, 163, 90, .18); color: #b08a3e; }
.badge-confirmed { background: rgba(74, 142, 92, .18); color: #3f8a55; }
.badge-rejected, .badge-cancelled { background: rgba(120, 112, 102, .18); color: #7a716a; }
.badge-locked { background: rgba(120, 112, 102, .14); color: #7a716a; }

/* 进度条 */
.prog { display: flex; justify-content: space-between; margin: 24rpx 0 4rpx; }
.prog-step { flex: 1; display: flex; flex-direction: column; align-items: center; font-size: 22rpx; color: #a99e8c; }
.prog-step .dot {
  width: 28rpx; height: 28rpx; border-radius: 50%; background: #d8d2c6;
  margin-bottom: 8rpx; border: 4rpx solid #fff; box-shadow: 0 0 0 2rpx #cdc6b8;
}
.prog-step.on { color: #9e3b2e; }
.prog-step.on .dot { background: #9e3b2e; box-shadow: 0 0 0 2rpx #9e3b2e; }

/* 主按钮 */
.btn-apply {
  margin: 12rpx 32rpx 8rpx; background: #9e3b2e; color: #fff;
  text-align: center; padding: 24rpx; border-radius: 48rpx;
  font-size: 30rpx; letter-spacing: 4rpx;
}
.btn-apply-top {
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.empty { text-align: center; color: #a99e8c; font-size: 26rpx; padding: 24rpx 0 8rpx; }
.entry { text-align: center; padding: 36rpx; color: #8a8175; font-size: 26rpx; margin-top: 16rpx; }

/* 弹窗 */
.mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(30, 28, 24, .72);
  display: flex; align-items: center; justify-content: center; z-index: 60;
}
.modal {
  width: 80%; background: #f6f2ea; border-radius: 28rpx; padding: 40rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, .3);
}
.modal-title { text-align: center; font-size: 32rpx; color: #3a352e; margin-bottom: 28rpx; letter-spacing: 2rpx; }
.ipt {
  width: 100%; box-sizing: border-box;
  background: #fff; border: 2rpx solid #d8d2c6; border-radius: 16rpx;
  padding: 20rpx 24rpx; font-size: 28rpx; color: #3a352e;
}
.btn {
  background: #9e3b2e; color: #fff; text-align: center;
  padding: 22rpx; border-radius: 48rpx; font-size: 30rpx; letter-spacing: 2rpx;
}
.btn-del {
  background: transparent; color: #8a8175; text-align: center;
  padding: 22rpx; border-radius: 48rpx; font-size: 28rpx;
  border: 2rpx solid #d8d2c6;
}

/* 同桌邀请面板 */
.share-code-row { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin: 16rpx 0 12rpx; }
.share-code { font-size: 60rpx; letter-spacing: 16rpx; color: var(--cinnabar); font-weight: 600; }
.share-copy { font-size: 26rpx; color: #fff; background: var(--cinnabar); padding: 12rpx 32rpx; border-radius: 1998rpx; }
.share-tip { font-size: 24rpx; color: var(--muted); line-height: 1.7; margin: 16rpx 0 28rpx; }
.share-qr { width: 400rpx; height: 400rpx; margin: 12rpx auto 24rpx; display: block; background: #fff; border-radius: 24rpx; padding: 20rpx; box-sizing: border-box; }
.share-qr-ph { text-align: center; color: var(--muted); font-size: 24rpx; padding: 60rpx 0; }
.share-forward { width: 100%; margin-top: 12rpx; }
.share-forward::after { border: none; }
.share-meta { text-align: center; font-size: 24rpx; color: var(--muted); margin-top: 24rpx; }
.share-ops { display: flex; gap: 28rpx; justify-content: center; margin-top: 28rpx; }
.share-op { font-size: 26rpx; color: var(--cinnabar); border: 2rpx solid #d8b78a; border-radius: 40rpx; padding: 12rpx 36rpx; }
.op-share { color: var(--cinnabar); border-color: #d8b78a; }

