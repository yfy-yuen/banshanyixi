<view class="page">
  <image class="app-bg" src="/assets/images/bg-landscape.jpg" mode="aspectFill"></image>

  <view wx:if="{{loading}}" class="loading-mask">
    <view class="spinner"></view>
    <view class="loading-tip">加载中…</view>
  </view>

  <view class="r-head">
    <view class="r-title">订位 · 一席之约</view>
    <view class="r-sub">择一席，留个位，静候启席</view>
  </view>

  <view class="btn-apply" bindtap="openApply">申请订位</view>

  <!-- 我的订位 -->
  <view class="r-sec">我的订位</view>
  <view wx:if="{{!mine.length}}" class="r-empty">还没有订位，点上方「申请订位」留个位吧</view>
  <view wx:for="{{mine}}" wx:key="id" class="mcard">
    <view class="mcard-top">
      <view class="mcard-date">{{item.date}} · {{item.mealText}}</view>
      <view class="badge badge-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="mcard-info">人数 {{item.partySize}} 人 · {{item.arrivalText}}</view>
    <view wx:if="{{item.note}}" class="mcard-note">备注：{{item.note}}</view>
    <view wx:if="{{item.roomText}}" class="mcard-room">已为您排定：{{item.roomText}}</view>
    <view wx:if="{{item.preorderCount}}" class="mcard-note">已预点 {{item.preorderCount}} 道菜{{item.preorderable ? '' : '（已锁定）'}}</view>
    <view wx:if="{{item.preorderable}}" class="mcard-preorder" data-id="{{item.id}}" bindtap="editPreorder">去预点菜</view>
    <view wx:elif="{{item.status==='pending' || item.status==='confirmed'}}" class="mcard-locked">距用餐不足 2 天，预点已锁定，请到店联系店员代加</view>
    <view wx:if="{{item.cancellable}}" class="mcard-cancel" data-id="{{item.id}}" bindtap="cancelMine">取消订位</view>
    <view wx:elif="{{item.status==='pending' || item.status==='confirmed'}}" class="mcard-locked">距用餐不足 2 天，无法自助取消，请到店联系店员取消</view>
  </view>

  <!-- 申请订位弹窗 -->
  <view class="mask" wx:if="{{showApply}}" bindtap="closeApply">
    <view class="modal" catchtap="noop">
      <view class="modal-title">申请订位</view>

      <view class="dl">日期</view>
      <picker mode="date" value="{{form.date}}" bindchange="onDate">
        <view class="ipt picker">{{form.date || '选择日期'}}</view>
      </picker>

      <view class="dl">预计到达时间</view>
      <picker mode="time" value="{{form.expectedArrival}}" bindchange="onArrival">
        <view class="ipt picker">{{form.expectedArrival || '选择时间'}}</view>
      </picker>

      <view class="dl">人数</view>
      <input class="ipt" type="number" value="{{form.partySize}}" bindinput="onParty" placeholder="用餐人数" placeholder-style="color:#5a544d;font-size:28rpx" />

      <view class="dl">手机号</view>
      <input class="ipt" type="number" value="{{form.contactPhone}}" bindinput="onPhone" placeholder="用于接收确认通知" placeholder-style="color:#5a544d;font-size:28rpx" />

      <view class="dl">备注（选填）</view>
      <input class="ipt" value="{{form.note}}" bindinput="onNote" placeholder="忌口 / 过敏 / 其他" placeholder-style="color:#5a544d;font-size:28rpx" />

      <view class="modal-note">订厢须先预点菜（必填）</view>
      <view class="btn" style="width:100%;margin-top:10px;" bindtap="goPreorder">去预点菜并提交</view>
      <view class="btn-del" style="width:100%;margin-top:10px;" bindtap="closeApply">返回</view>
    </view>
  </view>
</view>
