.page { padding: 14px; }
.app-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; }

/* 头部 */
.khead { display: flex; justify-content: space-between; align-items: center; padding: 4px 2px 12px; }
.kdate { font-size: 16px; font-weight: 600; color: var(--cinnabar); letter-spacing: 1px; }
.kacts { display: flex; gap: 8px; }
.kbtn { padding: 7px 14px; border-radius: 10px; background: var(--paper); color: var(--ink-light); font-size: 13px; border: 1px solid var(--border); }
.kbtn:active { background: var(--ink-light); color: var(--card); }

/* 视图切换 */
.kseg { display: flex; gap: 8px; margin-bottom: 14px; }
.kseg-btn { flex: 1; text-align: center; padding: 10px; border-radius: 10px; background: var(--paper); color: var(--ink-light); font-size: 14px; border: 1px solid var(--border); }
.kseg-btn.on { background: var(--ink-light); color: var(--card); border-color: var(--ink-light); }

/* 空态 */
.kempty { text-align: center; color: var(--muted); font-size: 14px; padding: 50px 0; }

/* 后厨出餐单：按包厢 */
.kroom { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 14px; margin-bottom: 14px; box-shadow: 0 3px 12px var(--shadow); }
.kroom-h { font-size: 18px; font-weight: 600; color: var(--ink); letter-spacing: 1px; margin-bottom: 8px; }
.kroom-no { font-size: 13px; color: var(--muted); margin-left: 8px; font-weight: 400; }
.klabel { font-size: 13px; color: var(--cinnabar); letter-spacing: 2px; margin: 10px 0 6px; border-left: 3px solid var(--cinnabar); padding-left: 8px; }
.kdish { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; padding: 6px 0; border-bottom: 1px dashed var(--border-light); }
.kdish-name { font-size: 16px; color: var(--ink); letter-spacing: 1px; }
.kdish-qty { font-size: 16px; font-weight: 600; color: var(--cinnabar); }
.kdish-note { font-size: 12px; color: var(--cinnabar); width: 100%; }
.korder-note { font-size: 13px; color: var(--cinnabar); background: #f7ede9; border-radius: 8px; padding: 8px 10px; margin-top: 10px; line-height: 1.5; }

/* 配菜汇总 */
.ksum-top { display: flex; justify-content: space-between; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px; margin-bottom: 12px; box-shadow: 0 3px 12px var(--shadow); }
.ksum-top text { font-size: 15px; color: var(--ink); letter-spacing: 1px; }
.ksum-total { font-size: 18px; font-weight: 600; color: var(--cinnabar); }
.ksum { display: flex; justify-content: space-between; align-items: center; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px; margin-bottom: 10px; }
.ksum-name { font-size: 16px; color: var(--ink); letter-spacing: 1px; }
.ksum-qty { font-size: 17px; font-weight: 600; color: var(--cinnabar); }

.ktip { text-align: center; color: var(--muted); font-size: 12px; line-height: 1.6; margin: 18px 0 8px; }
