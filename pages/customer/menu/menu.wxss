.cat-title {
  font-weight: 500;
  margin: 16rpx 8rpx 8rpx;
  color: #0c447c;
}
.dish {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dish-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.dish-name {
  font-size: 30rpx;
}
.dish-info {
  display: flex;
  flex-direction: column;
}
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #e6f1fb;
  color: #185fa5;
  font-size: 36rpx;
}
.step-num {
  width: 64rpx;
  text-align: center;
}
.table-input {
  margin-top: 12rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  padding: 16rpx;
}
.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.cart-sum {
  display: flex;
  flex-direction: column;
}
.cart-submit {
  margin: 0;
  padding: 0 48rpx;
}
.dish-img-hover { opacity: 0.82; }
/* 图片放大预览遮罩 */
.img-preview {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 2147483647;
  display: flex;
  align-items: center;
  justify-content: center;
}
.img-preview-pic {
  width: 92%;
  height: 92%;
}
.img-preview-tip {
  position: absolute;
  bottom: 60rpx;
  left: 0; right: 0;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  opacity: 0.8;
}
