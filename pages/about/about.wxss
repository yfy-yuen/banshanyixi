.page {
  min-height: 100vh;
  position: relative;
  padding: 0 28rpx 60rpx;
  box-sizing: border-box;
}
.app-bg {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  z-index: -1;
}

/* 顶部品牌 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 0 46rpx;
}
.logo {
  width: 128rpx;
  height: 128rpx;
}
.h-name {
  margin-top: 22rpx;
  font-size: 46rpx;
  letter-spacing: 10rpx;
  color: #f3d79a;
  font-family: "STKaiti", "KaiTi", serif;
}
.h-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d8cdb4;
  letter-spacing: 4rpx;
}

/* 卡片 */
.card {
  background: rgba(40, 37, 32, 0.62);
  border: 1rpx solid rgba(206, 162, 86, 0.35);
  border-radius: 18rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
}
.c-title {
  font-size: 28rpx;
  color: #f3d79a;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 18rpx;
}
.c-title::before {
  content: '';
  position: absolute;
  left: 0; top: 6rpx; bottom: 6rpx;
  width: 6rpx;
  background: #cea256;
  border-radius: 3rpx;
}
.c-body {
  font-size: 26rpx;
  line-height: 1.8;
  color: #ece3d2;
  white-space: pre-wrap;
}

/* 联系信息行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.r-left { flex: 1; }
.r-label {
  font-size: 24rpx;
  color: #cea256;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.r-val {
  font-size: 27rpx;
  color: #f3ede0;
  line-height: 1.5;
}
.r-go {
  font-size: 26rpx;
  color: #d8cdb4;
  margin-left: 20rpx;
}
.divider {
  height: 1rpx;
  background: rgba(206, 162, 86, 0.22);
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #b9ad94;
  letter-spacing: 3rpx;
  margin-top: 14rpx;
}
