.page {
  position: relative;
  z-index: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0;
}

/* 顶栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  background: var(--card);
  border-bottom: 1px solid var(--border);
}
.tb-name { font-size: 16px; color: var(--ink); letter-spacing: 2px; font-weight: 500; }
.tb-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
.tb-tag {
  color: var(--gold); font-size: 12px;
  padding: 4px 10px; border-radius: 6px;
  border: 1px solid var(--gold); letter-spacing: 1px;
}

/* 左栏 + 右分区 */
.body { flex: 1; display: flex; min-height: 0; }
.rail {
  width: 64px;
  background: var(--paper);
  border-right: 1px solid var(--border);
  padding: 8px 0;
}
.rail-item {
  text-align: center;
  font-size: 13px;
  color: var(--ink-light);
  padding: 13px 2px;
  letter-spacing: 1px;
}
.rail-item.on {
  color: var(--cinnabar);
  font-weight: 500;
  background: var(--card);
  border-left: 3px solid var(--cinnabar);
}
.panel { flex: 1; padding: 10px 12px 30px; }

/* 分区标题（墨笔分隔） */
.sec { margin-bottom: 6px; }
.sec-title { display: flex; align-items: center; gap: 10px; padding: 6px 2px 10px; }
.sec-title text { font-size: 15px; color: var(--ink); letter-spacing: 2px; font-weight: 500; }
.sec-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--border), transparent); }
.sec-foot { height: 20px; }

/* 菜品卡 */
.card {
  position: relative;
  overflow: hidden;
  display: flex;
  gap: 12px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 10px;
  box-shadow: 0 3px 12px var(--shadow);
}
/* 售罄 / 限定角标（第18条 菜品售罄标记） */
.corner {
  position: absolute; top: 0; right: 0;
  font-size: 11px; color: #fff; padding: 3px 9px;
  border-bottom-left-radius: 10px; letter-spacing: 1px;
}
.corner.limited { background: var(--gold); }
.corner.soldout { background: #8c8c8c; }
.card.sold-out { opacity: 0.6; }
.pic {
  width: 64px;
  height: 64px;
  border-radius: 10px;
  background: var(--paper);
  flex-shrink: 0;
}
.pic.seal {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cinnabar);
  color: #f4f0e8;
  font-size: 26px;
  font-weight: 500;
}
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ttl { font-size: 15px; font-weight: 500; color: var(--ink); letter-spacing: 1px; }
.badges { display: flex; gap: 6px; margin-top: 5px; flex-wrap: wrap; }
.badge { font-size: 11px; padding: 1px 8px; border-radius: 999px; border: 1px solid; }
.b-sign { color: var(--cinnabar); border-color: var(--cinnabar); }
.b-spicy { color: #b5562f; border-color: #b5562f; }
.b-veg { color: #4a6b4a; border-color: #4a6b4a; }
.b-season { color: var(--gold); border-color: var(--gold); }
.desc { font-size: 12px; color: var(--muted); margin-top: 5px; }
.bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }

/* 提示 */
.tip {
  text-align: center;
  font-size: 12px;
  color: var(--muted);
  letter-spacing: 1px;
  padding: 8px 0 20px;
}

/* 门店信息入口 */
.about-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 16px 18px;
  margin: 4px 0 24px;
}
.ae-text { flex: 1; }
.ae-main { font-size: 14px; color: var(--ink); letter-spacing: 1px; }
.ae-sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
.ae-arrow { color: var(--gold); font-size: 18px; margin-left: 12px; }

/* 顶栏搜索入口 */
.tb-search {
  display: flex; align-items: center; gap: 6px;
  background: var(--paper); border: 1px solid var(--border);
  border-radius: 999px; padding: 7px 14px; color: var(--muted); font-size: 13px;
}
.tb-search-ic { font-size: 16px; }

/* 搜索浮层（只读） */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 50;
}
.search-mask { background: rgba(55, 52, 46, 0.48); }
.search-page {
  width: 100%;
  height: 100%;
  background: var(--bg);
  display: flex;
  flex-direction: column;
}
.search-bar {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 14px; background: var(--card); border-bottom: 1px solid var(--border);
}
.sb-ic { font-size: 16px; color: var(--muted); }
.sb-input {
  flex: 1; background: var(--paper); border: 1px solid var(--border);
  border-radius: 999px; height: 36px; line-height: 36px;
  padding: 0 14px; font-size: 14px; color: var(--ink);
  box-sizing: border-box;
}
.sb-close { font-size: 13px; color: var(--muted); padding: 4px 6px; }
.search-res { flex: 1; padding: 12px 14px 30px; }
.s-empty { text-align: center; color: var(--muted); padding: 40px; font-size: 14px; }
