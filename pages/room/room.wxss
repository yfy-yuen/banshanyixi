.page { padding: 32rpx 32rpx 200rpx; }
.rhead { padding: 16rpx 0 36rpx; position: relative; }
.rname { font-size: 52rpx; letter-spacing: 12rpx; color: var(--ink); font-weight: 500; }
.rsub { font-size: 24rpx; color: var(--muted); margin-top: 12rpx; letter-spacing: 2rpx; }
.room-cta {
  position: absolute; top: 20rpx; right: 0;
  background: var(--cinnabar); color: #f4f0e8;
  font-size: 28rpx; letter-spacing: 2rpx;
  padding: 18rpx 40rpx; border-radius: 1998rpx;
  box-shadow: 0 4rpx 16rpx rgba(163, 53, 38, 0.28);
}
.room-cta:active { opacity: 0.85; }

.seg {
  display: flex;
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: 1998rpx;
  padding: 8rpx;
  margin-bottom: 36rpx;
}
.seg-btn {
  flex: 1; text-align: center; padding: 20rpx 0;
  font-size: 28rpx; color: var(--muted); border-radius: 1998rpx;
}
.seg-btn.on { color: var(--card); background: var(--cinnabar); font-weight: 500; }

/* 封面大图 */
.cover {
  width: 100%; height: 368rpx;
  border-radius: 28rpx; overflow: hidden;
  border: 2rpx solid var(--border); background: var(--paper);
  margin-bottom: 36rpx;
}
.cover-img { width: 100%; height: 100%; }
.cover-ph { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 28rpx; }

/* 区块标题（水墨笔触：后段淡去） */
.sec-t {
  font-size: 28rpx; color: var(--ink); font-weight: 500;
  letter-spacing: 2rpx; margin: 40rpx 0 24rpx;
  display: flex; align-items: baseline; gap: 20rpx;
}
.sec-t::after {
  content: ''; flex: 1; height: 2rpx;
  background: linear-gradient(90deg, var(--border), transparent);
}

/* 包厢介绍：富文本 */
.intro-body { font-size: 28rpx; line-height: 1.85; color: var(--ink-light); }
.intro-body img { width: 100%; border-radius: 20rpx; margin: 20rpx 0; }

/* 环境一览：2 列网格 */
.gal-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx; }
.gal-cell {
  border-radius: 24rpx; overflow: hidden;
  border: 2rpx solid var(--border); background: var(--paper);
  aspect-ratio: 4 / 3;
}
.gal-img { width: 100%; height: 100%; }

.order-bar {
  font-size: 26rpx; color: var(--ink-light);
  background: var(--paper); border: 2rpx solid var(--border-light);
  border-radius: 1998rpx; padding: 16rpx 28rpx; display: inline-block; margin-bottom: 28rpx;
}
.dish-row { display: flex; gap: 28rpx; align-items: center; }
.dish-img {
  width: 112rpx; height: 112rpx; border-radius: 20rpx;
  background: var(--paper); border: 2rpx solid var(--border); flex-shrink: 0;
}
.dish-img.ph { display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--muted); }
.dish-name { font-size: 30rpx; color: var(--ink); font-weight: 500; }
.dish-sub { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }
.o-note { font-size: 24rpx; color: var(--cinnabar); margin: 12rpx 0; line-height: 1.5; }

.empty { text-align: center; color: var(--muted); padding: 100rpx 0; font-size: 28rpx; }

/* 加载占位 */
.loading-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(250, 246, 238, 0.78);
}
.spinner {
  width: 44rpx; height: 44rpx;
  border: 5rpx solid rgba(184, 83, 63, 0.25);
  border-top-color: var(--cinnabar);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-tip { margin-top: 18rpx; font-size: 26rpx; color: var(--muted); letter-spacing: 4rpx; }

/* 包厢门禁（未解锁） */
.lock-box {
  margin: 80rpx 32rpx; padding: 60rpx 44rpx;
  background: var(--card); border: 2rpx solid var(--border);
  border-radius: 32rpx; text-align: center;
}
.lock-icon { font-size: 80rpx; }
.lock-tip { font-size: 32rpx; color: var(--ink); font-weight: 500; margin-top: 24rpx; letter-spacing: 2rpx; }
.lock-sub { font-size: 26rpx; color: var(--muted); margin-top: 16rpx; line-height: 1.6; }
.lock-input {
  width: 100%; box-sizing: border-box; margin-top: 36rpx;
  background: #fff; border: 2rpx solid var(--border); border-radius: 20rpx;
  padding: 24rpx; font-size: 36rpx; letter-spacing: 8rpx; text-align: center; color: var(--ink);
}
.lock-err { font-size: 24rpx; color: var(--cinnabar); margin-top: 20rpx; }
.lock-box .btn-apply { margin: 36rpx 0 0; }
