.page { padding: 16px 16px 100px; }

.hero { padding: 6px 2px 18px; }
.hero-title { font-size: 22px; color: var(--ink); letter-spacing: 4px; font-weight: 500; }
.hero-sub { font-size: 13px; color: var(--muted); margin-top: 4px; letter-spacing: 1px; }

.empty {
  text-align: center;
  padding: 90px 20px;
}
.empty-seal {
  width: 64px;
  height: 64px;
  line-height: 64px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background: var(--cinnabar);
  color: var(--card);
  font-size: 28px;
  font-family: serif;
  letter-spacing: 2px;
  box-shadow: 0 3px 10px rgba(160, 69, 56, 0.2);
}
.empty-text { font-size: 18px; color: var(--ink); letter-spacing: 3px; }
.empty-sub { font-size: 13px; color: var(--muted); margin: 8px 0 22px; }

.order-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 4px 18px var(--shadow);
}
.o-row { display: flex; justify-content: space-between; align-items: center; }
.oid { font-weight: 500; color: var(--ink); letter-spacing: 1px; }
.o-items { color: var(--muted); font-size: 13px; margin: 10px 0; line-height: 1.7; }
