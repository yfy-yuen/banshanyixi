.page { padding: 32rpx 32rpx 200rpx; }

.hero { padding: 12rpx 4rpx 36rpx; }
.hero-title { font-size: 44rpx; color: var(--ink); letter-spacing: 8rpx; font-weight: 500; }
.hero-sub { font-size: 26rpx; color: var(--muted); margin-top: 8rpx; letter-spacing: 2rpx; }

.empty {
  text-align: center;
  padding: 180rpx 40rpx;
}
.empty-seal {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  color: var(--card);
  font-size: 56rpx;
  font-family: serif;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(160, 69, 56, 0.2);
}
.empty-text { font-size: 36rpx; color: var(--ink); letter-spacing: 6rpx; }
.empty-sub { font-size: 26rpx; color: var(--muted); margin: 16rpx 0 44rpx; }

.order-card {
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 36rpx var(--shadow);
}
.o-row { display: flex; justify-content: space-between; align-items: center; }
.oid { font-weight: 500; color: var(--ink); letter-spacing: 2rpx; }
.o-items { color: var(--muted); font-size: 26rpx; margin: 20rpx 0; line-height: 1.7; }
