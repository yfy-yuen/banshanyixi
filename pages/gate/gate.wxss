.gate {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #0b0705;
}

/* 全屏开门视频（原生组件） */
.gate-video {
  position: absolute;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
}

/* ===== CSS 老木门静态兜底（视频不可用时的背景，防黑屏） ===== */
.gate-fallback {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(120% 80% at 50% 38%, rgba(180,130,70,0.16), transparent 60%),
    linear-gradient(180deg, #1a120b 0%, #070402 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.fb-plaque {
  padding: 16rpx 44rpx;
  font-size: 40rpx;
  letter-spacing: 10rpx;
  color: #f3d79a;
  background: #1a0e06;
  border: 3rpx solid #cea256;
  border-radius: 10rpx;
}

/* ===== 覆盖层（cover-view 层级最高，能盖住原生 video） ===== */
.gate-cover {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
}
.plaque {
  position: absolute;
  top: 64rpx;
  left: 20%;
  width: 60%;
  text-align: center;
  padding: 14rpx 0;
  font-size: 40rpx;
  letter-spacing: 10rpx;
  color: #f3d79a;
  background: #1a0e06;
  border: 3rpx solid #cea256;
  border-radius: 10rpx;
}
.gate-sub {
  position: absolute;
  left: 0;
  width: 100%;
  bottom: 320rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(243,233,214,0.82);
}
.gate-poem {
  position: absolute;
  left: 0;
  width: 100%;
  bottom: 260rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  color: rgba(232,215,170,0.92);
}
.gate-btn {
  position: absolute;
  left: 20%;
  width: 60%;
  bottom: 150rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 10rpx;
  color: #fbeede;
  background: #9c2417;
  border: 2rpx solid #e0b46a;
  border-radius: 44rpx;
}

/* ===== 老板隐藏入口 ===== */
.boss-seal {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(180,50,31,0.85);
  border-radius: 12rpx;
  background: rgba(180,50,31,0.25);
  text-align: center;
}
.boss-seal-t {
  font-size: 22rpx;
  line-height: 38rpx;
  color: #e9c7a0;
  letter-spacing: 1rpx;
}

/* 预加载 rooms 背景图 */
.preload {
  position: absolute;
  width: 1rpx; height: 1rpx;
  opacity: 0;
  z-index: -1;
  left: -10rpx; top: -10rpx;
}
