page {
  width: 100%;
  height: 100%;
}
.gate {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #0b0705;
}

/* 全屏开门视频（原生组件） */
.gate-video {
  position: absolute;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
}

/* ===== CSS 老木门静态兜底（视频不可用时的背景，防黑屏） ===== */
.gate-fallback {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background:
    radial-gradient(120% 80% at 50% 38%, rgba(180,130,70,0.16), transparent 60%),
    linear-gradient(180deg, #1a120b 0%, #070402 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.fb-plaque {
  padding: 16rpx 44rpx;
  font-size: 40rpx;
  letter-spacing: 10rpx;
  color: #f3d79a;
  background: #1a0e06;
  border: 3rpx solid #cea256;
  border-radius: 10rpx;
}

/* ===== 覆盖层（cover-view 层级最高，能盖住原生 video） ===== */
.gate-cover {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
}
/* logo 印章（cover-image，压在视频之上） */
.gate-logo {
  position: absolute;
  top: 90rpx;
  left: 315rpx;
  width: 120rpx;
  height: 120rpx;
}
/* 品牌大字（冻结定稿：行楷 56rpx 无框 原金 #f3d79a，位置 top:40vh） */
.plaque {
  position: absolute;
  top: 40vh;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 56rpx;
  letter-spacing: 14rpx;
  color: #f3d79a;
  font-family: 'STXingkai','行楷-简',KaiTi,serif;
}
/* 诗句（行楷，下移到原推门入席位置，再略下一点） */
.gate-poem {
  position: absolute;
  top: 69vh;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 34rpx;
  letter-spacing: 10rpx;
  color: rgba(236,217,168,0.95);
  font-family: 'STXingkai','行楷-简',KaiTi,serif;
}
/* 推门入席：紧凑金框围字 + 边框与文字一起呼吸 */
.gate-btn {
  position: absolute;
  left: 275rpx;
  width: 200rpx;
  top: 76vh;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  font-size: 34rpx;
  letter-spacing: 10rpx;
  color: #e9c7a0;
  font-family: 'STXingkai','行楷-简',KaiTi,serif;
  border: 2rpx solid #cea256;
  border-radius: 31rpx;
  animation: gateBreathe 2.2s ease-in-out infinite;
}
@keyframes gateBreathe {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 1; }
}

/* ===== 分流按钮（2026-08-21 用户授权新增；匾额/诗句/logo/老板印章等冻结视觉不变） ===== */
.gate-divider {
  position: absolute;
  top: 83vh;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: rgba(205,187,142,0.85);
  letter-spacing: 8rpx;
}
.gate-btn-sub {
  position: absolute;
  top: 87vh;
  width: 220rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  font-family: 'STXingkai','行楷-简',KaiTi,serif;
  border-radius: 32rpx;
  box-sizing: border-box;
}
.gate-btn-primary {
  background: #a63522;
  color: #fff;
}
.gate-btn-ghost {
  border: 2rpx solid #cea256;
  color: #e9c7a0;
}

/* ===== 老板隐藏入口（右上角印章，长按无，单击触发 BOSS_CODE 注册） ===== */
.boss-seal {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(180,50,31,0.85);
  border-radius: 12rpx;
  background: rgba(180,50,31,0.25);
  text-align: center;
}
.boss-seal-t {
  font-size: 22rpx;
  line-height: 38rpx;
  color: #e9c7a0;
  letter-spacing: 1rpx;
}

/* 预加载 rooms 背景图 */
.preload {
  position: absolute;
  width: 1rpx; height: 1rpx;
  opacity: 0;
  z-index: -1;
  left: -10rpx; top: -10rpx;
}
